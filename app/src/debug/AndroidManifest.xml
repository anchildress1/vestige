<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug manifest overlay. Merged into the debug APK only — never present in release builds.
  Registers DebugSeedReceiver so `make seed-entries` (adb am broadcast -n <component>) can
  preload fixture entries and patterns for dev iteration.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Exported only in debug so adb shell can trigger deterministic reinstall fixtures.
             Gated by android.permission.DUMP — `shell`, `root`, and platform-signed apps hold
             it; sideloaded user apps don't. The signature-permission alternative blocked the
             actual workflow (`adb shell` runs as `shell` uid, can't hold app-signature perms);
             DUMP gives back the safety net without breaking `make seed-entries`. -->
        <receiver
            android:name=".debug.DebugSeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver" />
    </application>

</manifest>
